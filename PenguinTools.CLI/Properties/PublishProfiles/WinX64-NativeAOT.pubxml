<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishAot>true</PublishAot>
        <SelfContained>true</SelfContained>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDir>bin\Release\net10.0\publish\WinX64-NativeAOT\</PublishDir>
    </PropertyGroup>

    <Target Name="RemoveStaleNativePublishSymbols" AfterTargets="Publish"
            Condition="'$(CopyOutputSymbolsToPublishDirectory)' == 'false'">
        <Delete Files="$(PublishDir)$(TargetName).pdb"/>
    </Target>
</Project>
