<Project>
    <PropertyGroup>
        <PenguinToolsTexconvDirectory>$(MSBuildThisFileDirectory)..\artifacts\tools\texconv</PenguinToolsTexconvDirectory>
        <PenguinToolsFfmpegPublishDir>$(MSBuildThisFileDirectory)..\artifacts\tools\ffmpeg</PenguinToolsFfmpegPublishDir>
        <PenguinToolsImageToolsDirectory>$(MSBuildThisFileDirectory)..\artifacts\tools\image-tools</PenguinToolsImageToolsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PenguinToolsTexconvContent Include="$(PenguinToolsTexconvDirectory)\texconv.exe;$(MSBuildThisFileDirectory)Licenses\DirectXTex.txt">
            <PublishPath>assets\texconv\%(Filename)%(Extension)</PublishPath>
        </PenguinToolsTexconvContent>
        <PenguinToolsInfrastructureAsset Include="$(MSBuildThisFileDirectory)..\Assets\assets.json">
            <ResourceName>assets.json</ResourceName>
            <ManifestKey>AssetsJson</ManifestKey>
            <PublishPath>assets\assets.json</PublishPath>
        </PenguinToolsInfrastructureAsset>
    </ItemGroup>

    <ItemGroup>
        <Content Include="@(PenguinToolsTexconvContent)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <TargetPath>%(PublishPath)</TargetPath>
            <Link>%(PublishPath)</Link>
        </Content>
        <Content Include="@(PenguinToolsInfrastructureAsset)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <TargetPath>%(PublishPath)</TargetPath>
            <Link>%(PublishPath)</Link>
        </Content>
    </ItemGroup>
</Project>
